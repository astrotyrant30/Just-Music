<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Outer Soundwave Ring -->
    <path
        android:strokeWidth="1.5"
        android:pathData="M54,18 A36,36 0 1,0 54,90 A36,36 0 1,0 54,18 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0.0" android:color="#44FF5277" />
                <item android:offset="1.0" android:color="#2200E5FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glassmorphic Icon Disc Surface -->
    <path
        android:pathData="M54,23 A31,31 0 1,0 54,85 A31,31 0 1,0 54,23 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="23"
                android:startY="23"
                android:endX="85"
                android:endY="85">
                <item android:offset="0.0" android:color="#35FFFFFF" />
                <item android:offset="0.4" android:color="#1A2D2B55" />
                <item android:offset="1.0" android:color="#250F0B24" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Dynamic Equalizer Soundwave Bars that form the "Just Music" waveform -->
    <!-- Bar 1 (Leftmost subtle beat) -->
    <path
        android:pathData="M34,48 L34,60 A2,2 0 0,0 38,60 L38,48 A2,2 0 0,0 34,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="46"
                android:endX="36"
                android:endY="62">
                <item android:offset="0.0" android:color="#FF758C" />
                <item android:offset="1.0" android:color="#FF5277" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bar 2 (Medium pulse) -->
    <path
        android:pathData="M41,40 L41,68 A2.5,2.5 0 0,0 46,68 L46,40 A2.5,2.5 0 0,0 41,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="43.5"
                android:startY="38"
                android:endX="43.5"
                android:endY="70">
                <item android:offset="0.0" android:color="#FF5277" />
                <item android:offset="1.0" android:color="#B339FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bar 3 (Center High Harmonic Peak / Music stem) -->
    <path
        android:pathData="M49,33 L49,75 A3,3 0 0,0 55,75 L55,33 A3,3 0 0,0 49,33 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="52"
                android:startY="30"
                android:endX="52"
                android:endY="78">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.25" android:color="#FF6B8B" />
                <item android:offset="0.75" android:color="#9D4EDD" />
                <item android:offset="1.0" android:color="#4D194D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bar 4 (Resonance crest) -->
    <path
        android:pathData="M58,38 L58,70 A2.5,2.5 0 0,0 63,70 L63,38 A2.5,2.5 0 0,0 58,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="60.5"
                android:startY="36"
                android:endX="60.5"
                android:endY="72">
                <item android:offset="0.0" android:color="#8E54E9" />
                <item android:offset="1.0" android:color="#00E5FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bar 5 (Right treble tail) -->
    <path
        android:pathData="M66,45 L66,63 A2,2 0 0,0 70,63 L70,45 A2,2 0 0,0 66,45 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="68"
                android:startY="43"
                android:endX="68"
                android:endY="65">
                <item android:offset="0.0" android:color="#4776E6" />
                <item android:offset="1.0" android:color="#00E5FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dynamic Curved Play Arc (Floating across top of bars) -->
    <path
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M43,36 C50,30 58,30 65,36">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="43"
                android:startY="33"
                android:endX="65"
                android:endY="33">
                <item android:offset="0.0" android:color="#FF758C" />
                <item android:offset="1.0" android:color="#00E5FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sparkling Accent Node -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M65,36m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0" />

</vector>
